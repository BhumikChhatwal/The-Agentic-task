# ---------------------------------------------------------------------------
# Byte Analyst configuration. Copy to `.env` and fill in.
# Nothing here is required to *run the tests* or the offline demo
# (`/byteanalyst demo`), which use the deterministic rule-based planner.
# An API key is required for real LLM-driven agent runs (`ask` / `chat`).
# ---------------------------------------------------------------------------

# Which LLM backend to use: openai_compatible | anthropic | offline
# Leave unset to auto-detect from the keys below.
# BYTEANALYST_PROVIDER=openai_compatible

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, Together, vLLM, Ollama, LM Studio ...)
# BYTEANALYST_API_KEY=sk-...
# For a local model, no key is needed but the base URL must be set:
#   BYTEANALYST_BASE_URL=http://localhost:11434/v1     # Ollama
#   BYTEANALYST_BASE_URL=http://localhost:1234/v1      # LM Studio
#   BYTEANALYST_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter
# BYTEANALYST_BASE_URL=https://api.openai.com/v1
# BYTEANALYST_MODEL=gpt-4o-mini

# --- Anthropic native API
# ANTHROPIC_API_KEY=sk-ant-...
# BYTEANALYST_MODEL=claude-3-5-sonnet-latest

# --- Behaviour knobs (all optional)
# BYTEANALYST_MAX_ITERATIONS=12
# BYTEANALYST_TEMPERATURE=0.0
# BYTEANALYST_REASONING_EFFORT=medium
# BYTEANALYST_TIMEOUT=120
# BYTEANALYST_MEMORY=on
